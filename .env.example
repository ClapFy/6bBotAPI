# Copy to .env and fill in. Never commit .env.

KRYNBOT_HOST=alt3.6b6t.org
KRYNBOT_PORT=25565
KRYNBOT_USERNAME=KrynoBot
KRYNBOT_PASSWORD=
KRYNBOT_AUTH=offline
KRYNBOT_VERSION=1.21.8

# Local control API (other UIs / scripts talk to this)
KRYNBOT_CONTROL_HOST=127.0.0.1
KRYNBOT_CONTROL_PORT=37637
# Leave empty on first run — the bot writes a random token into .env.
# curl needs: -H "authorization: Bearer $KRYNBOT_CONTROL_TOKEN"
KRYNBOT_CONTROL_TOKEN=
# Only set this if you intentionally bind the API off loopback.
# KRYNBOT_CONTROL_EXPOSE=1

# Offline accounts on 6b6t walk two server portals (auth + lobby).
KRYNBOT_SERVER_PORTALS=2
KRYNBOT_PORTAL_RETRY_MS=60000
KRYNBOT_RECONNECT_MS=8000
KRYNBOT_VIEW_DISTANCE=6
