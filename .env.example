# Copy this file to .env and provide the account credentials.

KRYNBOT_HOST=alt3.6b6t.org
KRYNBOT_PORT=25565
KRYNBOT_USERNAME=
KRYNBOT_PASSWORD=
KRYNBOT_AUTH=offline
KRYNBOT_VERSION=1.21.11

# Local control API
KRYNBOT_CONTROL_HOST=127.0.0.1
KRYNBOT_CONTROL_PORT=37637
# A random token is written to .env on first run when this is empty.
KRYNBOT_CONTROL_TOKEN=
# Required when intentionally binding the API off loopback.
# KRYNBOT_CONTROL_EXPOSE=1

# Offline accounts on 6b6t walk two server portals (auth + lobby).
KRYNBOT_SERVER_PORTALS=2
KRYNBOT_PORTAL_RETRY_MS=60000
KRYNBOT_RECONNECT_MS=8000
KRYNBOT_VIEW_DISTANCE=6
